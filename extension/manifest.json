{
  "manifest_version": 3,
  "name": "GeM-Intel — Procurement Price Intelligence",
  "version": "1.0.0",
  "description": "Real-time GFR Rule 149 price benchmark and audit intelligence for Government e-Marketplace (GeM)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GeM-Intel Price Benchmark"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://gem.gov.in/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://gem.gov.in/*", "*://localhost/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ]
}
