{
  "manifest_version": 3,
  "name": "GeM-Intel — Procurement Price Intelligence",
  "version": "2.0.0",
  "description": "Real-time GFR Rule 149 price benchmark and audit intelligence for Government e-Marketplace (GeM). Works like BuyHatke — automatically analyzes pricing on GeM product pages.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gem-intel@example.com",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GeM-Intel Price Benchmark"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://mkp.gem.gov.in/*",
    "https://gem.gov.in/*",
    "http://localhost:5000/*",
    "https://gem-intel.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mkp.gem.gov.in/*",
        "https://gem.gov.in/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
