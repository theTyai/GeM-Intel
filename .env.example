# ─────────────────────────────────────────────────────────────
#  GeM-Intel — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Backend (Node.js / Express) ────────────────────────────
BACKEND_PORT=5000
MONGODB_URI=mongodb://localhost:27017/gem_intel
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# ── Service URLs (for inter-service communication) ─────────
AI_SERVICE_URL=http://localhost:8000
PDF_SERVICE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173

# ── AI Service (Python / FastAPI) ──────────────────────────
AI_PORT=8000
USE_MOCK_DATA=true          # set to false when real scrapers are ready
MOCK_DATA_DIR=data

# ── PDF Service (Node.js / Puppeteer) ──────────────────────
PDF_PORT=5001

# ── Frontend (React / Vite) ────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ── Third-party DaaS (leave blank while using mock data) ───
BRIGHT_DATA_API_KEY=
SCRAPINGBEE_API_KEY=
SERPAPI_KEY=
