# GeM-Intel Global Environment Configuration
# Copy this file to .env before running the services

# ----------------------------------------------------
# 1. Database Configuration
# ----------------------------------------------------
# Replace with your actual MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://gem:gem@gem.vbor8rn.mongodb.net/?appName=GeM

# ----------------------------------------------------
# 2. External APIs
# ----------------------------------------------------
# Required for the Python AI Service to perform matching and extraction
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------------------------------
# 3. Security
# ----------------------------------------------------
# Secret used by the Node backend to sign JWTs (Change for production)
JWT_SECRET=production_super_secret_key_change_me_to_random_string

# ----------------------------------------------------
# 4. Routing
# ----------------------------------------------------
# The URL where the frontend is hosted (used by Node for CORS)
FRONTEND_URL=http://localhost

# The public URL where the Node API is hosted (injected into React at build time)
# Note: If deploying to a server with an IP or Domain, change localhost to that IP/Domain
VITE_API_BASE_URL=http://localhost:5000/api/v1
